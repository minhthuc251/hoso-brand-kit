{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "spacing": {
    "0":   { "$value": "0px" },
    "1":   { "$value": "4px",   "$description": "Icon padding, viền nhỏ" },
    "2":   { "$value": "8px",   "$description": "Padding component nhỏ" },
    "3":   { "$value": "12px",  "$description": "Gap giữa label và input" },
    "4":   { "$value": "16px",  "$description": "Padding mặc định" },
    "5":   { "$value": "24px",  "$description": "Gap giữa block trong section" },
    "6":   { "$value": "32px",  "$description": "Padding container" },
    "7":   { "$value": "48px",  "$description": "Gap giữa sections nhỏ" },
    "8":   { "$value": "64px",  "$description": "Gap giữa sections lớn" },
    "9":   { "$value": "96px",  "$description": "Padding section hero" },
    "10":  { "$value": "128px", "$description": "Padding marketing landing" }
  },
  "radius": {
    "none": { "$value": "0px" },
    "sm":   { "$value": "4px",  "$description": "Input, badge nhỏ" },
    "md":   { "$value": "8px",  "$description": "Button, card mặc định" },
    "lg":   { "$value": "12px", "$description": "Modal, card lớn" },
    "xl":   { "$value": "16px", "$description": "Container marketing" },
    "full": { "$value": "9999px", "$description": "Pill, avatar tròn" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px 0 rgba(96, 58, 23, 0.05)" },
    "md": { "$value": "0 4px 6px -1px rgba(96, 58, 23, 0.1), 0 2px 4px -2px rgba(96, 58, 23, 0.05)" },
    "lg": { "$value": "0 10px 15px -3px rgba(96, 58, 23, 0.1), 0 4px 6px -4px rgba(96, 58, 23, 0.05)" },
    "xl": { "$value": "0 20px 25px -5px rgba(96, 58, 23, 0.1), 0 8px 10px -6px rgba(96, 58, 23, 0.05)" }
  }
}
